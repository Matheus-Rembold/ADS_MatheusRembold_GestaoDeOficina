# Copie este arquivo para ".env" e preencha com os dados reais do seu ambiente.
# Em desenvolvimento o .env fica na raiz do projeto; no executável, na mesma
# pasta do Camaro.exe.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=camaro_db
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# true = imprime todo o SQL no console (só para depurar)
DB_ECHO=false

# Preencher quando formos implementar RF07/RF08
WHATSAPP_API_KEY=
NFE_API_KEY=
