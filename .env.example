# Copie este arquivo para ".env" e preencha com os dados reais do seu ambiente.
# Em desenvolvimento o .env fica na raiz do projeto; no executável, na mesma
# pasta do Camaro.exe.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=camaro_db
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# true = imprime todo o SQL no console (só para depurar)
DB_ECHO=false

# RF07: nome da oficina usado nas mensagens do WhatsApp
# ("Aqui é da oficina <nome>"). Vazio: "Aqui é da oficina".
OFICINA_NOME=
# Cabeçalho da OS impressa / PDF (opcionais; o que ficar vazio não aparece)
OFICINA_ENDERECO=
OFICINA_TELEFONE=
OFICINA_CNPJ=

# Preencher quando formos implementar RF08
NFE_API_KEY=
